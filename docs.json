{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Neuron",
  "colors": {
    "primary": "#0a0a0a",
    "light": "#ffffff",
    "dark": "#ffffff"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "decoration": "windows",
    "color": {
      "light": "#ffffff",
      "dark": "#000000"
    }
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "dark": "/logo/dark.png",
    "light": "/logo/light.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Introduction",
        "groups": [
          {
            "group": "Overview",
            "pages": ["index"]
          }
        ]
      },
      {
        "tab": "Getting Started",
        "groups": [
          {
            "group": "Start Here",
            "pages": [
              "getting-started/installation",
              "getting-started/quickstart"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Authoring",
            "pages": [
              "guides/typescript-sdk",
              "guides/yaml-authoring"
            ]
          },
          {
            "group": "Capability Runtimes",
            "pages": [
              "guides/capability-runtimes",
              "guides/wire-protocol"
            ]
          },
          {
            "group": "Configuration",
            "pages": ["guides/configuration"]
          }
        ]
      },
      {
        "tab": "Architecture",
        "groups": [
          {
            "group": "Core",
            "pages": [
              "architecture/overview",
              "architecture/execution-model",
              "architecture/providers"
            ]
          },
          {
            "group": "Operations",
            "pages": [
              "architecture/security",
              "architecture/persistence"
            ]
          }
        ]
      },
      {
        "tab": "CLI Reference",
        "groups": [
          {
            "group": "Commands",
            "pages": [
              "cli/overview",
              "cli/build",
              "cli/run",
              "cli/init",
              "cli/capability-runtime",
              "cli/project-runtime",
              "cli/other-commands"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Endpoints",
            "pages": [
              "api/overview",
              "api/assemblies",
              "api/instances",
              "api/events",
              "api/health"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/neuron-runtime/neuron"
    },
    "links": [
      {
        "header": "Documentation",
        "items": [
          { "label": "Getting Started", "href": "/getting-started/installation" },
          { "label": "Architecture", "href": "/architecture/overview" },
          { "label": "CLI Reference", "href": "/cli/overview" },
          { "label": "API Reference", "href": "/api/overview" }
        ]
      }
    ]
  }
}
